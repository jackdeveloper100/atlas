NODE_ENV=development
PORT=4000
 
# Supabase — obtain from your Supabase project settings
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
# Anon key — public API key, used ONLY for signInWithPassword on the backend
SUPABASE_ANON_KEY=your_anon_key_here

# Stripe — obtain from your Stripe dashboard
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret_here
STRIPE_FOUNDING_PRICE_ID=price_your_founding_member_price_id_here

# Frontend origins for CORS (comma-separated for multiple dev ports)
FRONTEND_URL=http://localhost:5173,http://localhost:5174,http://localhost:5175

# Email / SMTP Settings (Optional in dev; fallback JSON mailer used if unconfigured)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
EMAIL_FROM="ATLAS Alternate History" <noreply@atlas.com>
